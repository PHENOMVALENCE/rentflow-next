# Persistence
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rentflow?sslmode=require"

# Authentication
AUTH_SECRET="replace-in-runtime-only"

# First production bootstrap (used by npm run db:seed)
BOOTSTRAP_ORGANIZATION_NAME=""
BOOTSTRAP_ORGANIZATION_SLUG=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PHONE=""
BOOTSTRAP_ADMIN_PIN=""

# Payments
SNIPPE_BASE_URL="https://api.snippe.sh"
SNIPPE_API_KEY=""
SNIPPE_WEBHOOK_SECRET=""
SNIPPE_WEBHOOK_URL="https://your-domain.example/api/webhooks/payments/snippe"
SNIPPE_TIMEOUT_MS="15000"

# OTP / SMS — production uses Briq
SMS_PROVIDER="briq"
BRIQ_API_KEY=""
BRIQ_SENDER_ID=""

# WhatsApp — keep off until approved Briq templates are ready
WHATSAPP_PROVIDER="off"
WHATSAPP_TEMPLATE_PREFIX="rentflow_"
BRIQ_WHATSAPP_SENDER=""
WHATSAPP_TIMEOUT_MS="15000"

# Private object storage
# `local` is development-only. Production must use a private remote adapter once configured.
PRIVATE_STORAGE_DRIVER=""
PRIVATE_STORAGE_LOCAL_ROOT=".rentflow-private"

# Scheduled endpoints
CRON_SECRET=""
